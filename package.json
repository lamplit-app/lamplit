{
  "name": "lamplit",
  "version": "0.1.0",
  "private": true,
  "description": "A chat-centred, text-only storytelling app talking straight to any OpenAI-compatible endpoint.",
  "workspaces": [
    "app",
    "server",
    "e2e",
    "electron"
  ],
  "scripts": {
    "postinstall": "node tools/fetch-electron.mjs",
    "electron": "node tools/fetch-electron.mjs",
    "start": "node tools/dev.mjs",
    "server": "node server/src/index.js",
    "build": "npm run build -w app",
    "package": "node tools/package.mjs",
    "desktop": "node tools/desktop.mjs",
    "desktop:stage": "node tools/desktop.mjs --stage-only",
    "desktop:dist": "node tools/desktop.mjs --dist",
    "screenshots": "node tools/screenshots.mjs",
    "providers": "node tools/probe-providers.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "notes": "node tools/release-notes.mjs",
    "check:notes": "node tools/release-notes.mjs --check",
    "icons": "node tools/icons.mjs",
    "test": "npm run test -w app && npm run test -w server && npm run test:tools",
    "test:tools": "node --test \"tools/test/*.test.mjs\"",
    "test:app": "npm run test -w app",
    "test:server": "npm run test -w server",
    "e2e": "npm run build -w app && npm run test -w e2e",
    "e2e:quick": "npm run test -w e2e",
    "smoke": "node tools/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
